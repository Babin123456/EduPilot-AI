# ============================================================
# EduPilot AI — Backend Environment Configuration
# ============================================================
# Copy this file to .env in the same directory:
#   cp .env.example .env
#
# Then fill in your environment-specific values below.
# NEVER commit your .env file to version control.
#
# 🔑 Generate SECRET_KEY & JWT_SECRET_KEY (64-char hex):
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# ---- Application ----
APP_NAME=EduPilot AI
APP_ENV=development
DEBUG=true
SECRET_KEY=generate-with-python-secrets-token-hex-32

# ---- Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (MongoDB Atlas) ----
# Get your connection string from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=edupilot

# ---- JWT / Auth ----
JWT_SECRET_KEY=generate-with-python-secrets-token-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- LLM: Primary (Groq) ----
# Get API keys from https://console.groq.com → API Keys
GROQ_API_KEY_1=gsk_your_first_groq_api_key_here
GROQ_API_KEY_2=gsk_your_second_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- LLM: Fallback & Vision (Gemini) ----
# Get API keys from https://aistudio.google.com → Get API Key
# Configure multiple keys for automatic failover when quota is exhausted
GEMINI_API_KEY=AIzaSy_your_primary_gemini_api_key_here
GEMINI_API_KEY_1=AIzaSy_your_backup_gemini_api_key_1_here
GEMINI_API_KEY_2=AIzaSy_your_backup_gemini_api_key_2_here
GEMINI_MODEL=gemini-1.5-flash

# ---- Email (Gmail SMTP) — Optional ----
# Required only for live email dispatch; demo mode works without these.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=EduPilot AI
SMTP_FROM_EMAIL=

# ---- File Storage ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# ---- Embedding Model (RAG) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- RAG Settings ----
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=250
RAG_MAX_FILE_SIZE_MB=10
RAG_RETRIEVAL_K=15
RAG_VECTOR_INDEX_NAME=vector_index
