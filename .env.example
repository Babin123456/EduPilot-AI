# ============================================================
# EduPilot AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your environment values.
# NEVER commit your .env file to version control.
#
# 🔑 How to generate 64-character SECRET_KEY & JWT_SECRET_KEY:
# Run this command in Python / Terminal:
# python -c "import secrets; print('SECRET_KEY=' + secrets.token_hex(32)); print('JWT_SECRET_KEY=' + secrets.token_hex(32))"
# ============================================================

# ---- Application ----
APP_NAME=EduPilot AI
APP_ENV=development
DEBUG=true
SECRET_KEY=generate-with-python-secrets-token-hex-32

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (SQLite) ----
DATABASE_URL=sqlite:///./edupilot.db

# ---- JWT / Auth ----
JWT_SECRET_KEY=generate-with-python-secrets-token-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- LLM: Primary (Groq) ----
GROQ_API_KEY_1=gsk_your_first_groq_api_key_here
GROQ_API_KEY_2=gsk_your_second_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- LLM: Fallback (Gemini) ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- File Storage ----
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# ---- Embedding Model ----
EMBEDDING_MODEL=all-MiniLM-L6-v2
