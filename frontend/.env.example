# ============================================================
# EduPilot AI — Frontend Environment Configuration
# ============================================================
# Copy this file to .env in the same directory:
#   cp .env.example .env
#
# Then update VITE_API_URL to point to your running backend.
# NEVER commit your .env file to version control.
# ============================================================

# ---- Backend API URL ----
# Local development (default):
VITE_API_URL=http://localhost:8000/api/v1

# Production (Render deployment) — uncomment and replace:
# VITE_API_URL=https://your-backend-app.onrender.com/api/v1
