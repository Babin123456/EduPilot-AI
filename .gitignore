# ============================================================
# EduPilot AI — Root .gitignore
# ============================================================

# ---- Python & Virtual Environments ----
__pycache__/
*.pyc
backend/edupilot_backend.egg-info/
backend/.venv/
backend/.ruff_cache/

# ---- Node.js & Frontend Builds ----
frontend/node_modules/
frontend/dist/

# ---- Environment Secrets ----
.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# ---- Local Storage ----
backend/storage/*
!backend/storage/.gitkeep

# ---- Logs & Test Caches ----
*.log
.pytest_cache/
.coverage
