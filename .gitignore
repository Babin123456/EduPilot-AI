# ============================================================
# EduPilot AI — Root .gitignore
# ============================================================

# ---- Python & Virtual Environments ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/
venv/

# ---- Node.js & Frontend Builds ----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ---- Environment Secrets ----
.env
.env.local
.env.*.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# ---- Local Storage & Uploads ----
backend/storage/*
!backend/storage/.gitkeep
backend/app/storage/*
!backend/app/storage/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite

# ---- Logs & Test Caches ----
*.log
logs/
.pytest_cache/
.coverage

# ---- IDE & OS Artifacts ----
.vscode/
.idea/
.DS_Store
Thumbs.db
